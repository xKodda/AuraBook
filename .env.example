# Desarrollo: usar reservas ficticias y panel demo sin Supabase.
DEMO_MODE=true

# Al pasar a reservas reales en Supabase, usar DEMO_MODE=false y completar:
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública: sb_publishable_… (o la anon legacy en NEXT_PUBLIC_SUPABASE_ANON_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta solo de servidor: sb_secret_… (o la service_role legacy)
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (opcional en desarrollo; recomendado en producción anti-spam):
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# URL pública canónica para los enlaces de acceso por correo (ej. https://aurabook.cl).
NEXT_PUBLIC_SITE_URL=

# Contacto que ven los dueños en «Mi plan» para pagar o cambiar de plan (opcionales).
NEXT_PUBLIC_BILLING_CONTACT_EMAIL=
NEXT_PUBLIC_BILLING_CONTACT_WHATSAPP=

# Correos de reservas (API de Resend). Puede ser la misma API key usada en el SMTP de Supabase.
RESEND_API_KEY=
# Opcional. Por defecto: AuraBook <no-reply@aurabook.clikium.cl>
EMAIL_FROM=
# Secreto para la tarea diaria de recordatorios (Vercel Cron lo envía automáticamente).
CRON_SECRET=
