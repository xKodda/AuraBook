# Desarrollo: usar reservas ficticias y panel demo sin Supabase.
DEMO_MODE=true

# Al pasar a reservas reales en Supabase, usar DEMO_MODE=false y completar:
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública: sb_publishable_… (o la anon legacy en NEXT_PUBLIC_SUPABASE_ANON_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta solo de servidor: sb_secret_… (o la service_role legacy)
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (opcional en desarrollo; recomendado en producción anti-spam):
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# URL pública canónica (enlaces de correo, sitemap, Open Graph): https://aurabook.cl
NEXT_PUBLIC_SITE_URL=

# Contacto que ven los dueños en «Mi plan» para pagar o cambiar de plan (opcionales).
NEXT_PUBLIC_BILLING_CONTACT_EMAIL=
NEXT_PUBLIC_BILLING_CONTACT_WHATSAPP=

# «Contratar Premium» por transferencia (solo servidor). Sin banco ni número, la página pide escribir para recibirlos.
BILLING_BANK_NAME=
BILLING_BANK_ACCOUNT_TYPE=
BILLING_BANK_ACCOUNT_NUMBER=
# Opcionales (por defecto Clikium SpA, 78.399.278-7 y contacto@clikium.cl):
BILLING_BANK_HOLDER=
BILLING_BANK_RUT=
BILLING_BANK_EMAIL=
# A quién avisar cuando un negocio informa una transferencia (por defecto contacto@clikium.cl):
BILLING_NOTIFY_EMAIL=

# Correos de reservas (API de Resend). Puede ser la misma API key usada en el SMTP de Supabase.
RESEND_API_KEY=
# Opcional. Por defecto: AuraBook <no-reply@aurabook.clikium.cl>
EMAIL_FROM=
# Secreto para la tarea diaria de recordatorios (Vercel Cron lo envía automáticamente).
CRON_SECRET=
# A quién avisar cuando un negocio publica su página por primera vez (por defecto, BILLING_NOTIFY_EMAIL):
PLATFORM_NOTIFY_EMAIL=

# Avisos push al teléfono del dueño (Web Push). Generar UNA vez con: npx web-push generate-vapid-keys
# Las dos o ninguna. Cambiarlas invalida los avisos ya activados (cada dueño debe volver a activarlos).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto para los servicios de push si hay un problema con los envíos (por defecto mailto:contacto@clikium.cl):
VAPID_SUBJECT=
